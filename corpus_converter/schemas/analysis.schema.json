{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "locator": {
      "type": "object",
      "required": ["document_id", "block_id", "page_index", "section"],
      "properties": {
        "document_id": {"type": "string", "pattern": "^doc_[0-9a-f]{16}$"},
        "block_id": {"type": "string", "pattern": "^blk_[0-9a-f]{20}$"},
        "page_index": {"type": ["integer", "null"], "minimum": 0},
        "section": {"type": "string"}
      },
      "additionalProperties": false
    },
    "statement": {
      "type": "object",
      "required": ["statement", "support_status", "evidence"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "support_status": {"enum": ["supported", "evidence_cited_unverified", "partially_supported", "ambiguous", "unsupported", "not_reported"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/locator"}}
      },
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "work_id", "document_id", "extraction_mode", "research_problem", "methodology", "contributions", "method_components", "training_objectives", "limitations", "claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "work_id": {"type": "string", "pattern": "^work_[0-9a-f]{16}$"},
    "document_id": {"type": "string", "pattern": "^doc_[0-9a-f]{16}$"},
    "document_ids": {"type": "array", "items": {"type": "string"}},
    "extraction_mode": {"type": "string"},
    "research_problem": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
    "methodology": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
    "contributions": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
    "method_components": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
    "training_objectives": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
    "limitations": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/statement"}}
  },
  "additionalProperties": false
}
