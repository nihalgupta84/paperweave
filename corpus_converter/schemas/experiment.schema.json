{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "locator": {
      "type": "object",
      "required": ["document_id", "block_id", "page_index", "section"],
      "properties": {
        "document_id": {"type": "string", "pattern": "^doc_[0-9a-f]{16}$"},
        "block_id": {"type": "string", "pattern": "^blk_[0-9a-f]{20}$"},
        "page_index": {"type": ["integer", "null"], "minimum": 0},
        "section": {"type": "string"}
      },
      "additionalProperties": false
    },
    "statement": {
      "type": "object",
      "required": ["statement", "support_status", "evidence"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "support_status": {"enum": ["supported", "evidence_cited_unverified", "partially_supported", "ambiguous", "unsupported", "not_reported"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/locator"}}
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": ["name", "evidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "support_status": {"enum": ["supported", "evidence_cited_unverified"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/locator"}}
      },
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "work_id", "document_id", "datasets", "metrics", "baselines", "implementation_details", "results", "ablations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "work_id": {"type": "string", "pattern": "^work_[0-9a-f]{16}$"},
    "document_id": {"type": "string", "pattern": "^doc_[0-9a-f]{16}$"},
    "document_ids": {"type": "array", "items": {"type": "string"}},
    "datasets": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "metrics": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "baselines": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "implementation_details": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
    "results": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
    "ablations": {"type": "array", "items": {"$ref": "#/$defs/statement"}}
  },
  "additionalProperties": false
}
