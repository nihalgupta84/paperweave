{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {
    "locator": {
      "type": "object",
      "required": ["document_id", "block_id", "page_index", "section"],
      "properties": {
        "document_id": {"type": "string", "pattern": "^doc_[0-9a-f]{16}$"},
        "block_id": {"type": "string", "pattern": "^blk_[0-9a-f]{20}$"},
        "page_index": {"type": ["integer", "null"], "minimum": 0},
        "section": {"type": "string"}
      },
      "additionalProperties": false
    },
    "assignment": {
      "type": "object",
      "required": ["id", "name", "status", "source", "evidence"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "status": {"enum": ["accepted", "review_needed", "rejected"]},
        "source": {"type": "string"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/locator"}}
      },
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "work_id", "profile", "facets"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "work_id": {"type": "string", "pattern": "^work_[0-9a-f]{16}$"},
    "profile": {"type": "string"},
    "facets": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/assignment"}}}
  },
  "additionalProperties": false
}
