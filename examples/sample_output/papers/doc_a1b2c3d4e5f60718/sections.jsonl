{"block_id": "blk_44444444444444444444", "document_id": "doc_a1b2c3d4e5f60718", "type": "paragraph", "heading_level": null, "page_index": null, "section_path": ["Experiments"], "section_role": "experiments", "text": "Evaluated on the Sintel benchmark dataset, our method achieves an endpoint error (EPE) of 1.42 and runs at 35 FPS.", "bbox": null, "asset_path": null, "source": {"parser": "docx", "parser_version": "stdlib", "source_file": null, "source_index": 3}}
