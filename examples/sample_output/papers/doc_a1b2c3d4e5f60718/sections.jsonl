{"block_id": "blk_11111111111111111111", "document_id": "doc_a1b2c3d4e5f60718", "type": "title", "heading_level": 1, "page_index": null, "section_path": ["Robust Transformer Models for Optical Flow"], "section_role": "unknown", "text": "Robust Transformer Models for Optical Flow", "bbox": null, "asset_path": null, "source": {"parser": "docx", "parser_version": "stdlib", "source_file": null, "source_index": 0}}
{"block_id": "blk_22222222222222222222", "document_id": "doc_a1b2c3d4e5f60718", "type": "paragraph", "heading_level": null, "page_index": null, "section_path": ["Abstract"], "section_role": "abstract", "text": "Abstract: We study robust optical flow estimation in adverse conditions like fog and low light. Our proposed transformer network achieves high accuracy and real-time inference.", "bbox": null, "asset_path": null, "source": {"parser": "docx", "parser_version": "stdlib", "source_file": null, "source_index": 1}}
