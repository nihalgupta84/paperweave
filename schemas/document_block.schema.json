{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corpus-converter.local/schemas/document_block.schema.json",
  "title": "Normalized document block",
  "type": "object",
  "required": [
    "block_id",
    "document_id",
    "type",
    "heading_level",
    "page_index",
    "section_path",
    "text",
    "bbox",
    "asset_path",
    "source"
  ],
  "properties": {
    "block_id": {"type": "string", "pattern": "^blk_[0-9a-f]{20}$"},
    "document_id": {"type": "string", "pattern": "^doc_[0-9a-f]{16}$"},
    "type": {"type": "string", "minLength": 1},
    "heading_level": {"type": ["integer", "null"], "minimum": 1},
    "page_index": {"type": ["integer", "null"], "minimum": 0},
    "section_path": {"type": "array", "items": {"type": "string"}},
    "text": {"type": "string"},
    "bbox": {
      "type": ["array", "null"],
      "items": {"type": "number"},
      "minItems": 4,
      "maxItems": 4
    },
    "asset_path": {"type": ["string", "null"]},
    "source": {
      "type": "object",
      "required": ["parser", "parser_version", "source_file", "source_index"],
      "properties": {
        "parser": {"enum": ["mineru", "docx", "html"]},
        "parser_version": {"type": ["string", "null"]},
        "source_file": {"type": ["string", "null"]},
        "source_index": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
